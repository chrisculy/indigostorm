root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true
end_of_line = lf

# javadoc-style comments
block_comment_start = /*
block_comment = *
block_comment_end = */

[*.{js,json,jsx,ts,tsx}]
indent_style = tab
indent_size = 2
